render_table() {
    local -a fields=()
    local -a values=()
    local max_f=18
    local max_v=42

    while [ $# -ge 2 ]; do
        local f="$1"
        local v="$2"
        shift 2
        f="${f//$'\r'/}"
        v="${v//$'\r'/}"
        f="${f//$'\n'/ }"
        v="${v//$'\n'/ }"
        fields+=("$f")
        values+=("$v")
        [ "${#f}" -gt "$max_f" ] && max_f="${#f}"
        [ "${#v}" -gt "$max_v" ] && max_v="${#v}"
    done

    max_f=$((max_f + 2))
    max_v=$((max_v + 2))

    local h_f="" h_v=""
    printf -v h_f "%*s" $((max_f + 1)) ""
    printf -v h_v "%*s" $((max_v + 1)) ""
    h_f="${h_f// /-}"
    h_v="${h_v// /-}"

    local sep="  ${C_BORDER}+${h_f}+${h_v}+${C_RESET}"

    echo -e "$sep"
    printf "  ${C_BORDER}|${C_RESET} ${C_SUBTEXT}%-*s${C_RESET}${C_BORDER}|${C_RESET} ${C_SUBTEXT}%-*s${C_RESET}${C_BORDER}|${C_RESET}\n" "$max_f" "Field" "$max_v" "Value"
    echo -e "$sep"

    local idx
    local total_fields="${#fields[@]}"
    for ((idx=0; idx!=total_fields; idx++)); do
        printf "  ${C_BORDER}|${C_RESET} ${C_TEXT}%-*s${C_RESET}${C_BORDER}|${C_RESET} ${C_CYAN}%-*s${C_RESET}${C_BORDER}|${C_RESET}\n" "$max_f" "${fields[$idx]}" "$max_v" "${values[$idx]}"
    done

    echo -e "$sep"
    echo ""
}

SELECTED_INDEX=0
prompt_buttons() {
    local question="$1"
    local hint="$2"
    shift 2
    local -a btns=("$@")
    local count="${#btns[@]}"
    local cur=0
    local key=""

    tput civis 2>/dev/null || true
    echo -e "  ${C_BORDER}${question}${C_RESET}"
    echo ""
    tput sc 2>/dev/null || true

    while true; do
        tput rc 2>/dev/null || printf "\r"
        tput ed 2>/dev/null || true

        local line="  "
        local i
        for ((i=0; i!=count; i++)); do
            if [ "$i" -eq "$cur" ]; then
                if [[ "${btns[$i]}" =~ (Cancel|Abort|Quit|Remove) ]]; then
                    line+="${BTN_WARN_ACTIVE}   ${btns[$i]}   ${C_RESET}   "
                else
                    line+="${BTN_ACTIVE}   ${btns[$i]}   ${C_RESET}   "
                fi
            else
                line+="${BTN_INACTIVE}   ${btns[$i]}   ${C_RESET}   "
            fi
        done
        echo -e "$line"
        echo ""
        echo -e "  ${C_DIM}↔ toggle • enter submit • ${hint}${C_RESET}"

        IFS= read -rsn1 key < /dev/tty || true

        if [[ -z "$key" ]]; then
            SELECTED_INDEX="$cur"
            break
        elif [[ "$key" == $'\x1b' ]]; then
            local seq=""
            read -rsn2 -t 0.05 seq < /dev/tty || true
            case "$seq" in
                "[C"|"[B") cur=$(( (cur + 1) % count )) ;;
                "[D"|"[A") cur=$(( (cur - 1 + count) % count )) ;;
            esac
        else
            case "${key,,}" in
                l) cur=$(( (cur + 1) % count )) ;;
                h) cur=$(( (cur - 1 + count) % count )) ;;
                k)
                    if [[ "${btns[0],,}" == *keep* ]] || [[ "${btns[0],,}" == k* ]]; then
                        SELECTED_INDEX=0
                        break
                    fi
                    ;;
                w)
                    if [ "$count" -ge 2 ] && { [[ "${btns[1],,}" == *wipe* ]] || [[ "${btns[1],,}" == w* ]]; }; then
                        SELECTED_INDEX=1
                        break
                    elif [[ "${btns[0],,}" == *erase* ]] || [[ "${btns[0],,}" == *wipe* ]] || [[ "${btns[0],,}" == *yes* ]]; then
                        SELECTED_INDEX=0
                        break
                    fi
                    ;;
                i|y)
                    SELECTED_INDEX=0
                    break
                    ;;
                n)
                    if [ "$count" -ge 2 ]; then
                        SELECTED_INDEX=1
                        break
                    fi
                    ;;
                b)
                    if [ "$count" -ge 3 ] && [[ "${btns[2],,}" == b* ]]; then
                        SELECTED_INDEX=2
                        break
                    elif [ "$count" -ge 2 ] && [[ "${btns[1],,}" == *back* ]]; then
                        SELECTED_INDEX=1
                        break
                    fi
                    ;;
                c)
                    if [ "$count" -ge 3 ]; then
                        SELECTED_INDEX=2
                        break
                    elif [ "$count" -ge 2 ] && [[ "${btns[1],,}" == *cancel* ]]; then
                        SELECTED_INDEX=1
                        break
                    fi
                    ;;
                1|2|3|4)
                    local num_idx=$((key - 1))
                    if [ "$num_idx" -lt "$count" ]; then
                        SELECTED_INDEX="$num_idx"
                        break
                    fi
                    ;;
                q)
                    SELECTED_INDEX=$((count - 1))
                    break
                    ;;
            esac
        fi
    done

    tput cnorm 2>/dev/null || true
    echo ""
}

